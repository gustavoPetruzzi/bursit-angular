{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": ".",
    "rootDir": ".",
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "tsconfig.json"]
}
