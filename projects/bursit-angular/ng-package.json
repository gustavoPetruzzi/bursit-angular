{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/bursit-angular",
  "deleteDestPath": true,
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": [
      "../../node_modules/bursit-ui-tokens/src"
    ]
  },
  "assets": [
    {
      "glob": "**/*",
      "input": "schematics",
      "output": "schematics",
      "ignore": ["**/*.ts", "**/tsconfig.json"]
    },
    {
      "glob": "**/*",
      "input": "src/styles",
      "output": "styles"
    }
  ]
}
