---
import { STORYBOOK_URL } from '../consts';

// Sticky site header. Purely static: no scroll listeners, no hydration.
// The "solid when scrolled" feel comes from an always-on hairline plus a
// translucent background derived from `--color-bg` with `color-mix`.
const inPageLinks = [
  { href: '#philosophy', label: 'Philosophy' },
  { href: '#tokens', label: 'Tokens' },
  { href: '#components', label: 'Components' },
  { href: '#getting-started', label: 'Getting started' },
];

const githubUrl = 'https://github.com/gustavoPetruzzi/bursit-angular';
---

<header class="site-header">
  <nav class="site-nav container" aria-label="Primary">
    <a class="wordmark" href="#top">
      <span class="wordmark__mark" aria-hidden="true"></span>
      <span class="wordmark__text">Bursit Angular</span>
    </a>

    <ul class="site-nav__links">
      {
        inPageLinks.map((link) => (
          <li>
            <a class="site-nav__link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="site-nav__actions">
      <a
        class="btn btn--ghost btn--sm"
        href={githubUrl}
        rel="noopener"
        aria-label="Bursit Angular on GitHub"
      >
        <svg
          class="site-nav__github-icon"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.26 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.8.56A11.53 11.53 0 0 0 23.5 12.02C23.5 5.74 18.27.5 12 .5Z"
          ></path>
        </svg>
        <span class="site-nav__github-text">GitHub</span>
      </a>

      <a class="btn btn--primary btn--sm" href={STORYBOOK_URL} rel="noopener">Storybook</a>
    </div>
  </nav>
</header>

<style lang="scss">
  .site-header {
    position: sticky;
    top: var(--space-0);
    z-index: var(--z-index-sticky);
    // Solid fallback first: if `color-mix` is unsupported the declaration below
    // is dropped and the header stays opaque instead of translucent.
    background-color: var(--color-bg);
    border-bottom: var(--border-width-thin) var(--border-style) var(--color-border);
  }

  @supports (background-color: color-mix(in srgb, red 50%, transparent)) {
    .site-header {
      background-color: color-mix(in srgb, var(--color-bg) 82%, transparent);
      backdrop-filter: blur(var(--layout-nav-blur));
    }
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    min-block-size: var(--space-3xl);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-tight);

    &:hover {
      color: var(--color-text);
    }
  }

  .wordmark__mark {
    inline-size: var(--space-md);
    block-size: var(--space-md);
    border-radius: var(--radius-sm);
    background-image: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    box-shadow: var(--shadow-sm);
  }

  // Mobile default: the in-page links wrap onto their own scrollable row so
  // nothing is hidden behind a hamburger that would need JavaScript.
  .site-nav__links {
    display: flex;
    order: 1;
    flex-basis: 100%;
    gap: var(--space-md);
    min-inline-size: var(--space-0);
    max-inline-size: 100%;
    padding-bottom: var(--space-xs);
    overflow-x: auto;
  }

  @media (min-width: 64em) {
    .site-nav__links {
      order: 0;
      flex: 1 1 auto;
      flex-basis: auto;
      justify-content: flex-start;
      gap: var(--space-lg);
      margin-inline-start: auto;
      padding-bottom: var(--space-0);
    }
  }

  .site-nav__link {
    display: inline-block;
    padding-block: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-in-out);

    &:hover {
      color: var(--color-text);
    }
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-inline-start: auto;
  }

  .site-nav__github-icon {
    flex: none;
  }

  // On the narrowest screens the GitHub label collapses to its icon; the link
  // keeps its accessible name through `aria-label` on the anchor below.
  @media (max-width: 30em) {
    .site-nav__github-text {
      display: none;
    }
  }
</style>
